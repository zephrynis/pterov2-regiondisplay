{
  "$schema": "./vendor/sdk/manifest.schema.json",
  "id": "regiondisplay",
  "name": "Region Display",
  "version": "1.0.1",
  "description": "Assign countries and region labels to locations and display them on servers.",
  "provider": "RegionDisplay\\RegionDisplayProvider",
  "autoload": {
    "RegionDisplay\\": "src"
  },
  "requires": {
    "panel": ">=2.0.0-dev <2.0.0-beta.3",
    "sdk": ">=2.0.0-beta.6 <2.0.0-beta.7",
    "php": ">=8.3 <9"
  },
  "ui": {
    "entry": "dist/client.js",
    "mode": "native"
  }
}
